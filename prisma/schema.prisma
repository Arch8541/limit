// Prisma Schema for LIMIT Platform - Supabase PostgreSQL
// Version: 2.0.0 - Production Ready
// Auth: Supabase Auth (users managed in auth.users, not Prisma)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// PROJECT MODEL - Core Business Entity
// ============================================================================

model Project {
  id               String   @id @default(cuid())
  userId           String   // Supabase Auth UUID — no FK to User table

  // Basic Info
  name             String   @db.VarChar(200)
  address          String?  @db.VarChar(500)
  latitude         Float?
  longitude        Float?

  // Regulatory Classification
  authority        String   @db.VarChar(50)
  zone             String   @db.VarChar(50)

  // Plot Dimensions
  plotLength       Float
  plotWidth        Float
  plotArea         Float
  boundaryCoordinates String?  // JSON string for polygon coordinates

  // Site Conditions
  isCornerPlot     Boolean  @default(false)
  roadWidthPrimary Float
  roadWidthSecondary Float?

  // Usage & Special Conditions
  intendedUse      String   @db.VarChar(100)
  heritage         Boolean  @default(false)
  toz              Boolean  @default(false)  // Traffic Optimization Zone
  sez              Boolean  @default(false)  // Special Economic Zone

  // Calculation Results (JSON strings)
  regulationResult String?  // GDCR calculation results
  gdcrClauses      String?  // Applicable GDCR clauses
  extractedData    String?  // AI-extracted drawing data

  // Status & Metadata
  reportId         String?  @db.VarChar(100)
  status           String   @default("draft")  // draft, processing, completed, error
  thumbnail        String?  @db.Text

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Composite Indexes for Performance
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([status])
  @@index([authority, zone])
}
