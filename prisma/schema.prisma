// Prisma Schema for LIMIT Platform - AWS RDS PostgreSQL Optimized
// Version: 2.0.0 - Production Ready

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  image         String?

  // Relationships
  projects      Project[]
  accounts      Account[]
  sessions      Session[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Indexes
  @@index([email])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ============================================================================
// PROJECT MODEL - Core Business Entity
// ============================================================================

model Project {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  name             String   @db.VarChar(200)
  address          String?  @db.VarChar(500)
  latitude         Float?
  longitude        Float?

  // Regulatory Classification
  authority        String   @db.VarChar(50)
  zone             String   @db.VarChar(50)

  // Plot Dimensions
  plotLength       Float
  plotWidth        Float
  plotArea         Float
  boundaryCoordinates String?  // JSON string for polygon coordinates

  // Site Conditions
  isCornerPlot     Boolean  @default(false)
  roadWidthPrimary Float
  roadWidthSecondary Float?

  // Usage & Special Conditions
  intendedUse      String   @db.VarChar(100)
  heritage         Boolean  @default(false)
  toz              Boolean  @default(false)  // Traffic Optimization Zone
  sez              Boolean  @default(false)  // Special Economic Zone

  // Calculation Results (JSON strings)
  regulationResult String?  // GDCR calculation results
  gdcrClauses      String?  // Applicable GDCR clauses
  extractedData    String?  // AI-extracted drawing data

  // Status & Metadata
  reportId         String?  @db.VarChar(100)
  status           String   @default("draft")  // draft, processing, completed, error
  thumbnail        String?  @db.Text

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Composite Indexes for Performance
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([status])
  @@index([authority, zone])
}
